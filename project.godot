; Engine configuration file.
; Fortune Cookie: A Little Luck — Godot 4.7
config_version=5

[application]

config/name="Fortune Cookie: A Little Luck"
config/description="An offline, 30-language fortune cookie experience."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.968627, 0.92549, 0.843137, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="FortuneCookieALittleLuck"

[autoload]

SettingsManager="*res://scripts/settings_manager.gd"
LocalizationManager="*res://scripts/localization_manager.gd"
FortuneManager="*res://scripts/fortune_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/size/min_width=320
window/size/min_height=520
window/size/initial_position_type=2
window/stretch/mode="disabled"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=true

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_size=18

[internationalization]

locale/fallback="en"
locale/test="en"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.968627, 0.92549, 0.843137, 1)
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false

[audio]

driver/enable_input=false
